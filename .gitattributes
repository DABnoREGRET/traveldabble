# Enforce consistent line endings across the project (LF on checkout/build).
# Prevents WSL/Windows CRLF churn that produces spurious diffs.

* text=auto eol=lf

# Build/config files must always be LF
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jks binary
*.keystore binary
