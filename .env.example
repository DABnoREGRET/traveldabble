# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ─── Public hostname (only used by the bundled Caddy + docker-compose path) ───
DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# ─── Postgres ────────────────────────────────────────────────────────────────
# Two URL flavors are accepted; pick one:
#   A) JDBC URL — pair with explicit DATABASE_USER + DATABASE_PASSWORD env vars.
#      Used by the bundled docker-compose path.
#   B) postgres:// URI — credentials embedded in the URL. Used by managed
#      hosts (Fly.io, Render, Railway, Heroku) which inject DATABASE_URL
#      automatically. DATABASE_USER / DATABASE_PASSWORD are ignored in this case.
#
# Examples:
#   DATABASE_URL=jdbc:postgresql://postgres:5432/app
#   DATABASE_URL=postgres://app:secret@host:5432/app
DATABASE_NAME=app
DATABASE_USER=app
DATABASE_PASSWORD=change-me-to-a-strong-password
DATABASE_MAX_POOL_SIZE=10
