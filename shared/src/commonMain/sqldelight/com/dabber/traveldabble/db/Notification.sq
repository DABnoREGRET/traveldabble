CREATE TABLE NotificationEntity (
    id INTEGER PRIMARY KEY NOT NULL,
    userId TEXT NOT NULL,
    type TEXT NOT NULL,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    data TEXT,
    isRead INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);

selectByUserId:
SELECT * FROM NotificationEntity WHERE userId = ? ORDER BY createdAt DESC;

upsert:
INSERT OR REPLACE INTO NotificationEntity(id, userId, type, title, body, data, isRead, createdAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

markAsRead:
UPDATE NotificationEntity SET isRead = 1 WHERE id = ?;

deleteById:
DELETE FROM NotificationEntity WHERE id = ?;

deleteAll:
DELETE FROM NotificationEntity;
